{
  "name": "ai-tools-assessment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run minify:html && npm run minify:css && npm run minify:js && npm run copy:assets",
    "minify:html": "node scripts/minify-html.js",
    "minify:css": "cleancss -o dist/styles.css styles.css",
    "minify:js": "terser favicon.js -o dist/favicon.js -c -m",
    "copy:assets": "node scripts/copy-assets.js"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "clean-css-cli": "^5.6.3",
    "terser": "^5.37.0"
  }
}
